<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<AnchorPane prefHeight="450.0" prefWidth="600.0" 
            stylesheets="@../css/estilo_login.css" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.mycompany.autenticacionautorizacion.LoginController">
   <children>

      <VBox alignment="CENTER" layoutX="150.0" layoutY="75.0" prefHeight="300.0" prefWidth="300.0" spacing="20.0" styleClass="tarjeta-login">
         <children>
            
            <Label text="Inicio de Sesión" styleClass="titulo-login" />
            
            <TextField fx:id="txtCredencial" promptText="Correo o ID" />
            
            <PasswordField fx:id="txtPassword" promptText="Contraseña" />
            
            <Button mnemonicParsing="false" onAction="#iniciarSesion" text="Ingresar" prefWidth="240.0" />
            
            
            <Label fx:id="lblError" styleClass="label-error" />
         </children>
      </VBox>
   </children>
</AnchorPane>